# ═══════════════════════════════════════════
# LUCID — Environment Variables
# Copy this to .env.local and fill in values
# ═══════════════════════════════════════════

# Supabase — get from supabase.com → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Auth — generate with: openssl rand -hex 32
JWT_SECRET=generate-a-64-character-random-string-here

# Image storage bucket name
NEXT_PUBLIC_STORAGE_BUCKET=lucid-uploads

# Optional: Geocoding for location display
# Get from console.cloud.google.com or mapbox.com
GEOCODING_API_KEY=
